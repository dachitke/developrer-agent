# Copy this file to ".env" and fill in real values. Never commit ".env".

# Required: your OpenAI API key
OPENAI_API_KEY=your_api_key_here

# Optional: chat model that supports tool calling (default: gpt-4o-mini)
MODEL_NAME=gpt-4o-mini

# Optional: sampling temperature, 0 = most deterministic (default: 0)
TEMPERATURE=0

# Optional: the only directory the file reader tool may access (default: data)
DATA_DIR=data

# Optional: logging level - DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
